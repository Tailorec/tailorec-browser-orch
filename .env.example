# Browser service
PORT=4000

# Control API tokens
AGENT_RUNTIME_JWT_SECRET=replace-me
AGENT_RUNTIME_JWT_ISSUER=tailorec-backend
AGENT_RUNTIME_JWT_AUDIENCE=tailorec-agent-runtime

# Headless mode (preferred)
BROWSER_HEADLESS=true
# Browser viewport (widthxheight) used for launched windows/screenshots
BROWSER_VIEWPORT=1280x720
# Legacy fallback supported by config
# HEADLESS=true

# Default browser viewport for tabs/screenshots (WIDTHxHEIGHT)
BROWSER_VIEWPORT=1280x720

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
LOG_TO_FILE=true
LOG_FILE_PATH=logs/app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
