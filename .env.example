# HTTP port used by the Express server.
PORT=4000

# Runtime mode used by config/logging behavior.
NODE_ENV=development

# Browser provider profile (`local` uses CDP port, `browserless` uses endpoint URL).
BROWSER_PROVIDER=local
# Remote browser endpoint used when `BROWSER_PROVIDER=browserless`.
BROWSER_ENDPOINT=
# Local Chrome DevTools port used when `BROWSER_PROVIDER=local`.
BROWSER_CDP_PORT=9222
# Runs browser without visible UI when true.
BROWSER_HEADLESS=true
# Legacy fallback for headless mode when `BROWSER_HEADLESS` is not set.
HEADLESS=
# Adds Chrome `--no-sandbox` flags when true.
BROWSER_NO_SANDBOX=false
# Legacy fallback for sandbox flag when `BROWSER_NO_SANDBOX` is not set.
NO_SANDBOX=
# Browser viewport parsed as `WIDTHxHEIGHT` for launched tabs/screenshots.
BROWSER_VIEWPORT=1280x720

# Global upper bound for active run-owned browser sessions.
BROWSER_MAX_SESSIONS=200
# Session cap used for local provider admission control.
BROWSER_LOCAL_MAX_SESSIONS=5
# Active browserless sessions allowed per worker task.
BROWSER_BROWSERLESS_SESSIONS_PER_WORKER=5
# Global upper bound for active browserless sessions across all worker tasks.
BROWSER_BROWSERLESS_MAX_TOTAL_SESSIONS=20
# Max time to wait for an assigned browserless worker to become ready (milliseconds).
BROWSER_BROWSERLESS_READY_TIMEOUT_MS=60000
# Poll interval while waiting for a browserless worker to become ready (milliseconds).
BROWSER_BROWSERLESS_READY_POLL_INTERVAL_MS=1000
# Grace period before an empty browserless worker is shut down (milliseconds).
BROWSER_BROWSERLESS_IDLE_GRACE_MS=30000
# ECS cluster used when allocator-owned browserless workers are launched on demand.
BROWSER_BROWSERLESS_ECS_CLUSTER=
# ECS task definition ARN/name used for allocator-owned browserless workers.
BROWSER_BROWSERLESS_ECS_TASK_DEFINITION=
# JSON array of subnet IDs for browserless ECS task networking.
BROWSER_BROWSERLESS_ECS_SUBNETS=
# JSON array of security group IDs for browserless ECS task networking.
BROWSER_BROWSERLESS_ECS_SECURITY_GROUPS=
# awsvpc public IP assignment mode for browserless ECS tasks (`ENABLED` or `DISABLED`).
BROWSER_BROWSERLESS_ECS_ASSIGN_PUBLIC_IP=DISABLED
# Browserless container port exposed by allocator-owned worker tasks.
BROWSER_BROWSERLESS_PORT=3000
# Optional browserless token appended when connecting to allocator-owned worker tasks.
BROWSER_BROWSERLESS_TOKEN=
# TTL for create-tab idempotency cache entries (milliseconds).
BROWSER_CREATE_IDEMPOTENCY_TTL_MS=600000
# Retry-After seconds returned when admission control rejects new sessions.
BROWSER_ADMISSION_RETRY_AFTER_SECONDS=5
# Idle timeout before a run session is auto-closed (milliseconds; 0 disables idle expiry).
BROWSER_SESSION_IDLE_TIMEOUT_MS=1200000
# Hard max lifetime for a run session before auto-close (milliseconds; 0 disables lifetime expiry).
BROWSER_SESSION_MAX_LIFETIME_MS=14400000
# Interval for sweeping expired sessions/idempotency cache (milliseconds).
BROWSER_SESSION_CLEANUP_SWEEP_MS=30000
# Grace period before a degraded session is auto-closed (milliseconds; 0 disables degraded auto-close).
BROWSER_SESSION_DEGRADED_CLOSE_GRACE_MS=60000

# Timeout for downloading remote upload files before file-chooser actions fail (milliseconds).
BROWSER_UPLOAD_DOWNLOAD_TIMEOUT_MS=45000
# Max bytes allowed for uploaded/downloaded files used by file-chooser hooks.
BROWSER_UPLOAD_MAX_BYTES=15728640
# Keeps temporary staged upload files when set to true.
BROWSER_KEEP_STAGED_UPLOADS=false

# Frame push interval for `/control/live` websocket screenshots (milliseconds, min effective 200).
CONTROL_FRAME_INTERVAL_MS=350

# HMAC secret used to sign/verify control JWTs.
AGENT_RUNTIME_JWT_SECRET=replace-me
# Fallback JWT secret key if `AGENT_RUNTIME_JWT_SECRET` is unset.
JWT_SECRET_KEY=
# Expected/issued `iss` claim for control JWTs.
AGENT_RUNTIME_JWT_ISSUER=tailorec-backend
# Expected/issued `aud` claim for control JWTs.
AGENT_RUNTIME_JWT_AUDIENCE=tailorec-agent-runtime

# Header name used to read/write correlation IDs.
CORRELATION_ID_HEADER=x-correlation-id

# Log level for application logger.
# In production/staging runtime, effective level is clamped to at least `warn`.
LOG_LEVEL=info
# Log formatter (`json` or `console`).
LOG_FORMAT=json
# Enables file logging when true.
LOG_TO_FILE=true
# Destination file path for logs.
LOG_FILE_PATH=logs/app.log
# Max size per log file before rotation (bytes).
LOG_MAX_BYTES=10485760
# Number of rotated log files to keep.
LOG_BACKUP_COUNT=5

# Explicit Linux Chrome/Chromium executable path checked before Playwright cache discovery.
CHROME_EXECUTABLE_PATH=
# Playwright browser cache root scanned for Chromium binaries.
PLAYWRIGHT_BROWSERS_PATH=

# OS PATH used to locate Chrome/Chromium executables by name.
PATH=
# Windows local app data path used for executable discovery.
LOCALAPPDATA=
# Windows Program Files path used for executable discovery.
PROGRAMFILES=
# Windows Program Files (x86) path used for executable discovery.
PROGRAMFILES(X86)=

# Test-only Vitest coverage shard selector.
COVERAGE_PHASE=1
