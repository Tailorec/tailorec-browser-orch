{
  "name": "tailorec-browser-service",
  "version": "1.0.0",
  "type": "module",
  "description": "Standalone browser control service ported from OpenClaw",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:contract": "vitest run --project contract",
    "test:coverage": "COVERAGE_PHASE=1 vitest run --coverage",
    "test:coverage:phase1": "COVERAGE_PHASE=1 vitest run --coverage",
    "test:coverage:phase2": "COVERAGE_PHASE=2 vitest run --coverage",
    "test:coverage:phase3": "COVERAGE_PHASE=3 vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "dotenv": "^17.2.4",
    "express": "^4.18.2",
    "playwright": "^1.40.0",
    "playwright-core": "^1.40.0",
    "tslog": "^4.9.2",
    "ws": "^8.16.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/supertest": "^7.2.0",
    "@types/ws": "^8.5.10",
    "@vitest/coverage-v8": "^3.2.4",
    "supertest": "^7.2.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^3.2.4"
  }
}
